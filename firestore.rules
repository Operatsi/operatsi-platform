rules_version = '2';

// ===============================================================
// OperatSI - Enterprise Cloud Firestore Security Rules
// ===============================================================
//
// Collection: users
// Document ID: {userId} (matching request.auth.uid)
// Fields:
//   - uid: string (matches document userId)
//   - email: string
//   - name: string
//   - displayName: string
//   - authProvider: string
//   - emailVerified: boolean
//   - photoURL: string or null
//   - jobTitle: string
//   - language: string
//   - preferredLanguage: string
//   - timeZone: string
//   - timezone: string
//   - bio: string
//   - phoneNumber: string
//   - mobileNumber: string
//   - phoneCountryCode: string
//   - phoneDialCode: string
//   - phoneNational: string
//   - createdAt: timestamp
//   - updatedAt: timestamp
//   - verifiedAt: timestamp
//
// Subcollections under users:
//   - /users/{userId}/notifications/{notificationId}: Real-time notifications
//   - /users/{userId}/settings/notifications: Notification channel preferences
//   - /users/{userId}/devices/{deviceId}: Push device registration records
//   - /users/{userId}/sessions/{sessionId}: Active user sessions
//   - /users/{userId}/security_events/{eventId}: Security audit logs
//   - /users/{userId}/{allPaths=**}: User-scoped nested documents
//
// Collection: activities
// Document ID: {userId}
// Subcollections: /activities/{userId}/{allPaths=**}
//
// Collection: user_activities
// Document ID: {userId}
// Subcollections: /user_activities/{userId}/{allPaths=**}
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Core security helper functions (Supporting both signedIn and isAuthenticated)
    function isAuthenticated() {
      return request.auth != null;
    }

    function signedIn() {
      return isAuthenticated();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Validation helper: prevent UID manipulation during write operations
    function isValidUserWrite(userId) {
      return !('uid' in request.resource.data) || request.resource.data.uid == userId;
    }

    // =============================================================
    // NEW RULES: REAL-TIME NOTIFICATIONS, PREFERENCES & DEVICES
    // =============================================================

    // Real-Time In-App Notifications
    match /users/{uid}/notifications/{notificationId} {
      allow get, list: if isOwner(uid);

      // Notifications are created & deleted only by trusted backend services.
      allow create, delete: if false;

      // Users can only mark read or archive their own notifications
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['readAt', 'archivedAt'])
        && (request.resource.data.readAt == null || request.resource.data.readAt is timestamp)
        && (request.resource.data.archivedAt == null || request.resource.data.archivedAt is timestamp);
    }

    // User Notification Preferences
    match /users/{uid}/settings/notifications {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // Device Registrations for Web Push (backend-managed)
    match /users/{uid}/devices/{deviceId} {
      // Device registrations are backend-managed.
      allow read, write: if false;
    }

    // =============================================================
    // OLD RULES: USERS, SESSIONS, ACTIVITIES & USER SUBCOLLECTIONS
    // =============================================================

    // Users collection rules: strictly enforce owner access for reads, writes, and profile deletion
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserWrite(userId);
      allow update: if isOwner(userId) && isValidUserWrite(userId);
      allow delete: if isOwner(userId);
    }

    // Active session tracking & revocation
    match /users/{userId}/sessions/{sessionId} {
      allow read, write, delete: if isOwner(userId);
    }

    // Security event audit log
    match /users/{userId}/security_events/{eventId} {
      allow read, write: if isOwner(userId);
    }

    // User-scoped subcollections (Preserved from Old Rules)
    match /users/{userId}/{allPaths=**} {
      allow read, write, delete: if isOwner(userId);
    }

    // User activities & audit logging collections (Preserved from Old Rules)
    match /activities/{userId} {
      allow read, write, delete: if isOwner(userId);
    }

    match /activities/{userId}/{allPaths=**} {
      allow read, write, delete: if isOwner(userId);
    }

    match /user_activities/{userId} {
      allow read, write, delete: if isOwner(userId);
    }

    match /user_activities/{userId}/{allPaths=**} {
      allow read, write, delete: if isOwner(userId);
    }

    // =============================================================
    // 4. WORKSPACES, MEMBERSHIP, ROLES & INVITATIONS
    // =============================================================

    // Workspace metadata: authenticated users can read workspace documents
    match /workspaces/{workspaceId} {
      allow read: if signedIn();
      allow write: if false; // Managed via server-side admin APIs
    }

    // Workspace members: authenticated members can read directory in real-time
    match /workspaces/{workspaceId}/members/{memberId} {
      allow read: if signedIn();
      allow write: if false; // Role changes & removals enforced server-side
    }

    // Workspace invitations: authenticated users can read invitations list
    match /workspaces/{workspaceId}/invitations/{invitationId} {
      allow read: if signedIn();
      allow write: if false; // Tokens and email dispatch managed server-side
    }

    // Workspace roles & permissions
    match /workspaces/{workspaceId}/roles/{roleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Workspace audit telemetry
    match /workspaces/{workspaceId}/audit/{auditId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Single-use token hash index: backend-managed only
    match /workspace_invitations_by_token/{tokenHash} {
      allow read, write: if false;
    }

    // Catch-all rule: strictly deny access to any unspecified collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
