rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId} (matching request.auth.uid)
// Fields:
//   - uid: string (matches document userId)
//   - email: string
//   - name: string
//   - displayName: string
//   - authProvider: string
//   - emailVerified: boolean
//   - photoURL: string or null
//   - jobTitle: string
//   - language: string
//   - preferredLanguage: string
//   - timeZone: string
//   - timezone: string
//   - bio: string
//   - phoneNumber: string
//   - mobileNumber: string
//   - phoneCountryCode: string
//   - phoneDialCode: string
//   - phoneNational: string
//   - createdAt: timestamp
//   - updatedAt: timestamp
//   - verifiedAt: timestamp
//
// Subcollections under users:
//   - /users/{userId}/{allPaths=**}: User-scoped nested documents
//
// Collection: activities
// Document ID: {userId}
// Subcollections: /activities/{userId}/{allPaths=**}
//
// Collection: user_activities
// Document ID: {userId}
// Subcollections: /user_activities/{userId}/{allPaths=**}
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Core security helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validation helper: prevent UID manipulation during write operations
    function isValidUserWrite(userId) {
      return !('uid' in request.resource.data) || request.resource.data.uid == userId;
    }

    // Users collection rules: strictly enforce owner access for reads, writes, and profile deletion
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserWrite(userId);
      allow update: if isOwner(userId) && isValidUserWrite(userId);
      allow delete: if isOwner(userId);
    }

    // User-scoped subcollections
    match /users/{userId}/{allPaths=**} {
      allow read, write, delete: if isOwner(userId);
    }

    // User activities & audit logging collections
    match /activities/{userId} {
      allow read, write, delete: if isOwner(userId);
    }

    match /activities/{userId}/{allPaths=**} {
      allow read, write, delete: if isOwner(userId);
    }

    match /user_activities/{userId} {
      allow read, write, delete: if isOwner(userId);
    }

    match /user_activities/{userId}/{allPaths=**} {
      allow read, write, delete: if isOwner(userId);
    }

    // Catch-all rule: strictly deny access to any unspecified collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
